# Copy this file to infra/.env. Never commit infra/.env.
#
# Local HTTP works for initial setup only. Production must use real DNS names
# without an http:// prefix so Caddy obtains certificates automatically.
NEWSROOM_SITE=http://localhost
N8N_SITE=http://n8n.localhost
N8N_HOST=n8n.localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://n8n.localhost/
N8N_WEBHOOK_URL=http://n8n.localhost/
N8N_SECURE_COOKIE=false

# Generate both values independently, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_JWT_SECRET=

# Generate a replacement:
#   docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext 'YOUR PASSWORD'
# Single quotes keep Compose from expanding the dollar signs.
NEWSROOM_BASIC_AUTH_USER=operator
NEWSROOM_BASIC_AUTH_HASH=
N8N_GATE_USER=operator
N8N_GATE_HASH=

NEWSROOM_LIVE_RESEARCH=true
NEWSROOM_REQUEST_TIMEOUT_SECONDS=12
NEWSROOM_CORS_ORIGINS=http://localhost,http://127.0.0.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---------------------------------------------------------------------------
# Post Studio: prompt -> image -> review -> Instagram
# ---------------------------------------------------------------------------
# Image generation. Set ONE key; the pipeline picks the first configured
# provider unless NEWSROOM_IMAGE_PROVIDER names one. With no key, slides are
# visibly stamped placeholders that the publish gate always refuses.
NEWSROOM_IMAGE_PROVIDER=auto
NEWSROOM_IMAGE_TIMEOUT_SECONDS=120
GOOGLE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
IMAGEN_MODEL=imagen-4.0-generate-001
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-1.1-pro

# Instagram never accepts uploaded bytes. It fetches image_url and video_url
# from its own servers, so generated media needs a public HTTPS address.
#   local -> served by this API at NEWSROOM_PUBLIC_BASE_URL
#   s3    -> uploaded to any S3-compatible bucket (Cloudflare R2, B2, MinIO)
NEWSROOM_MEDIA_HOST=local
NEWSROOM_PUBLIC_BASE_URL=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=giani/posts

# Instagram Content Publishing API (Meta Graph).
#   facebook  -> graph.facebook.com, IG Business account linked to a Page
#   instagram -> graph.instagram.com, Instagram Login, no Page required
# App credentials enable appsecret_proof on every Graph call and token
# exchange/refresh via POST /api/instagram/exchange-token and /refresh-token.
# INSTAGRAM_PUBLISH_ENABLED stays false until you have published a test post by
# hand and want the desk to be able to post on its own.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_LOGIN_MODE=facebook
INSTAGRAM_GRAPH_VERSION=v21.0
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# META_ACCESS_TOKEN is read as an alias when INSTAGRAM_ACCESS_TOKEN is unset.
INSTAGRAM_PUBLISH_ENABLED=false
INSTAGRAM_DAILY_POST_LIMIT=5

# Telegram is deliberately off. Store the bot token in an n8n Telegram
# credential after import; only the non-secret chat ID belongs here.
TELEGRAM_ENABLED=false
TELEGRAM_CHAT_ID=

# Pin images deliberately when updating production.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.30.5
CADDY_IMAGE=caddy:2.10.2-alpine
NEWSROOM_IMAGE_TAG=local
NEWSROOM_WEB_IMAGE_TAG=local
N8N_EXECUTIONS_MAX_AGE_HOURS=336
